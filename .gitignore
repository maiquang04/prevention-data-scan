# Never let project documents into a public repository. build/check_publish.py
# catches these too, but keeping them unstaged means a stray copy cannot reach a
# commit by accident in the first place.
*.xlsx
*.xls
*.xlsm
*.docx
*.doc
*.pdf
*.eml
*.msg
*.pptx
*.csv
*.zip

# The one exception: the list every page is generated from. build/check_publish.py
# reads it for the same banned names and phrases as every other text file.
!data/sources.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local server scratch
*.log

# Search prototype. The page check's screenshots go to search/results/, and older
# evaluation outputs and downloaded abstracts may still sit in a working copy; the
# abstracts belong to their publishers. None of it is committed.
search/results/
search/data/abstracts.json

# Docker. The model file is gigabytes and belongs to its publisher; .env holds
# one machine's paths.
models/
*.gguf
.env
