# Never let project documents into a public repository. build/check_publish.py
# catches these too, but keeping them unstaged means a stray copy cannot reach a
# commit by accident in the first place.
*.xlsx
*.xls
*.xlsm
*.docx
*.doc
*.pdf
*.eml
*.msg
*.pptx
*.csv
*.zip

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local server scratch
*.log

# Search prototype. Its evaluation results, screenshots and the abstracts it downloads
# are generated on one laptop against one model, and the papers' abstracts belong to
# their publishers. The code and the test questions are committed; these are not.
search/results/
search/data/abstracts.json
